  - "\u5F71\u304C\u7E54\u308A\u4E0A\u3052\u305F\u8FF7\u5BAE\u306E\u8A66\u7DF4\u306B\u6311\u3080"
  - "\u76EE\u899A\u3081\u3066\u6012\u308B\u5DE8\u77F3\u306E\u5B88\u8B77\u8005\u3092\u306A\u3060\u3081\u308B\u5FC5\u8981\u304C\u3042\u308B"
